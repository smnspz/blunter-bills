# --- Server ---
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# Optional: require "Authorization: Bearer <key>" on every endpoint except /health
SERVICE_API_KEY=
# Where the authorized session is persisted
DATA_DIR=.data

# --- Enable Banking application ---
# Application ID shown in https://enablebanking.com/cp/applications
ENABLE_BANKING_APP_ID=
# PEM private key. Either inline (use \n for newlines) ...
ENABLE_BANKING_PRIVATE_KEY=
# ... or a path to the PEM file (recommended)
ENABLE_BANKING_PRIVATE_KEY_PATH=./private.key

# Use https://api.enablebanking.com for both sandbox and production apps.
# The environment is determined by the application you registered.
ENABLE_BANKING_BASE_URL=https://api.enablebanking.com
ENABLE_BANKING_JWT_AUDIENCE=api.enablebanking.com

# Must exactly match one of the redirect URLs registered for the app
ENABLE_BANKING_REDIRECT_URL=http://localhost:3000/auth/callback

# Defaults used by POST /auth when the request does not specify them
ENABLE_BANKING_ASPSP_NAME=
ENABLE_BANKING_ASPSP_COUNTRY=

# How long the bank consent should be valid for, in days
ENABLE_BANKING_ACCESS_VALID_DAYS=90
# Upstream request timeout
ENABLE_BANKING_TIMEOUT_MS=30000
