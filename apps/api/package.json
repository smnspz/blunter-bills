{
  "name": "@blunter-bills/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify backend for Blunter Bills",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--conditions=development tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "NODE_OPTIONS=--conditions=development node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@blunter-bills/enable-banking": "workspace:*",
    "@blunter-bills/mail": "workspace:*",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
