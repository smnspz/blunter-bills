{
  "name": "blunter-bills",
  "version": "0.1.0",
  "private": true,
  "description": "Personal finance dashboard for Enable Banking accounts",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @blunter-bills/api --filter @blunter-bills/web dev",
    "dev:api": "pnpm --filter @blunter-bills/api dev",
    "dev:web": "pnpm --filter @blunter-bills/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
